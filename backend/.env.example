# Studable API - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Application
APP_NAME=Studable API
APP_VERSION=1.0.0
DEBUG=false

# PostgreSQL connection string (psycopg3 / SQLAlchemy 2.0)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:%40Kumawat8875%40@localhost:5432/studable

# CORS origins — JSON array of allowed origins
# In production: replace with your real frontend domain
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# CORS origins for Railway — set this in Railway's environment variables
ALLOWED_ORIGINS=https://studable-eight.vercel.app,http://localhost:3000,http://localhost:5173

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Redis URL
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=production
REFRESH_COOKIE_SECURE=true
